# URL pública del sitio (ej. https://mi-sitio.netlify.app). Se usa para og:image, og:url y canonical. Si no se define, el build usa la URL de Netlify (URL / DEPLOY_PRIME_URL) y, como último recurso, rutas relativas.
VITE_SITE_URL=

# VITE_DEMO_BRAND_NAME: Nombre de marca para el banner DEMO (vacío hasta definir la marca).
VITE_DEMO_BRAND_NAME=
# VITE_DEMO_BRAND_URL: URL HTTP(S) del servicio a enlazar en el banner DEMO (vacía hasta definirla).
VITE_DEMO_BRAND_URL=
