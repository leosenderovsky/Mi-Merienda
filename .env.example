# URL publica del sitio (ej. https://mi-sitio.netlify.app). Se usa para og:image, og:url y canonical.
# Orden de resolucion: VITE_SITE_URL; en production, URL de Netlify; en deploy-preview/otros contextos, DEPLOY_PRIME_URL; luego URL y DEPLOY_PRIME_URL como respaldo; y, si no hay valor, rutas relativas.
VITE_SITE_URL=

# VITE_DEMO_BRAND_NAME: Nombre de marca para el banner DEMO (vacío hasta definir la marca).
VITE_DEMO_BRAND_NAME=
# VITE_DEMO_BRAND_URL: URL HTTP(S) del servicio a enlazar en el banner DEMO (vacía hasta definirla).
VITE_DEMO_BRAND_URL=
