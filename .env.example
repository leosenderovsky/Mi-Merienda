# URL pública canónica del sitio. En Netlify se puede omitir: se usa DEPLOY_PRIME_URL/URL.
VITE_SITE_URL=

# VITE_DEMO_BRAND_NAME: Nombre de marca para el banner DEMO (vacío hasta definir la marca).
VITE_DEMO_BRAND_NAME=
# VITE_DEMO_BRAND_URL: URL HTTP(S) del servicio a enlazar en el banner DEMO (vacía hasta definirla).
VITE_DEMO_BRAND_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
